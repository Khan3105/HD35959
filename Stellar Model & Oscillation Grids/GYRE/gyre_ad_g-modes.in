&model
        model_type = 'EVOL'
        file = '__GYRE_FILE__'
        file_format = 'MESA'
/

&constants
/

&mode
        l = 1
        m = -1
        n_pg_min = -200
        n_pg_max = 0
/

&mode
       l = 2
       m = -1
       n_pg_min = -200
       n_pg_max = 0
/

&osc
	nonadiabatic = .FALSE.
	outer_bound = 'JCD'
	inertia_norm = 'BOTH'
	x_ref = 1
/

&num
        diff_scheme = 'COLLOC_GL2'
        restrict_roots = .FALSE.
/

&scan
        grid_type = 'INVERSE'
        freq_units = 'CYC_PER_DAY'
        freq_min = 0.1
        freq_max = 0.9
        n_freq = 300
/

&grid
	w_ctr = 10
	w_osc = 10
	w_exp = 2
/

&rot
	coriolis_method = 'TAR'
	Omega_rot_source = 'MODEL'
	Omega_rot_units = 'RAD_PER_SEC'
/

&ad_output
        summary_file = '__OUTPUT_DIR__/summary_g.txt'
        summary_file_format = 'TXT'
        summary_item_list = 'l,m,n_pg,n_p,n_g,omega,freq,beta,E_norm'
        freq_units = 'CYC_PER_DAY'
/

&nad_output
/
